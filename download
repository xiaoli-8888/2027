/* ============== /* ============ 气泡对话(鼠标靠近触发) ============ */
const avatarDebounce = {}; // 每人1秒内只触发一次
function checkAvatarProximity(mouseX, mouseY) {
  document.querySelectorAll(".companion-card").forEach(card => {
    const id = card.dataset.id;
    const rect = card.getBoundingClientRect();
    const cx = rect.left + rect.width / 2;
    const cy = rect.top + rect.height / 2;
    const dist = Math.hypot(mouseX - cx, mouseY - cy);
    if (dist < 100 && !avatarDebounce[id]) {
      avatarDebounce[id] = true;
      showBubble(cx, rect.top - 8, id);
      setTimeout(() => avatarDebounce[id] = false, 1800);
    }
  });
}
function showBubble(x, y, personId) {
  const lines = BUBBLE_LINES[personId] || ["嘿,看看这里"];
  const text = lines[Math.floor(Math.random() * lines.length)];
  const b = document.createElement("div");
  b.className = "bubble";
  b.textContent = text;
  b.style.left = x + "px";
  b.style.top = y + "px";
  document.body.appendChild(b);
  setTimeout(() => b.remove(), 3200);
}
document.addEventListener("mousemove", (e) => {
  if (!document.body.classList.contains("splash-done")) return;
  checkAvatarProximity(e.clientX, e.clientY);
});

