<title>After Closet — 挑几个搭子,陪你逛</title>
<style>
  /* ===== Design Tokens (After Hours 风格) ===== */
  :root {
    --bg: #FAFAFA;
    --bg-elev: #FFFFFF;
    --text: #1A1A1A;
    --text-muted: #8A8A8A;
    --text-faint: #C4C4C4;
    --border: #E8E8E8;
    --brand: #1A1A1A;
    --brand-soft: #F0F0F0;
    --accent: #E63946;
    --radius: 14px;
    --radius-sm: 8px;
    --radius-full: 999px;
    --font: "PingFang SC", "Helvetica Neue", "Inter", system-ui, -apple-system, sans-serif;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { height: 100%; }
  body {
    font-family: var(--font);
    background: var(--bg);
    color: var(--text);
    font-size: 14px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    letter-spacing: 0.01em;
    overflow-x: hidden;
  }
  a { color: inherit; text-decoration: none; }
  button { font-family: inherit; cursor: pointer; border: none; background: none; color: inherit; }

  /* ===== Page Transitions ===== */
  .page { display: none; min-height: 100%; animation: fadeIn .4s ease; }
  .page.active { display: block; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

  /* ===== Page 1: Select Companions ===== */
  .select-page { padding: 32px 40px 120px; overflow: visible; }
  .brand-title {
    font-size: 48px;
    font-weight: 300;
    letter-spacing: -0.02em;
    margin-bottom: 8px; text-align: left;
  }
  .brand-title em { font-style: italic; font-weight: 400; }
  .brand-sub {
    font-size: 15px;
    color: var(--text-muted);
    margin-bottom: 24px; text-align: left;
    letter-spacing: 0.02em;
  }
  .section-label {
    font-size: 12px;
    color: var(--text-faint);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }

  .companions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 32px;
  }
  .companion-card {
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    transition: transform .25s ease;
    padding: 0;
    position: relative;
  }
  .companion-card:hover { transform: translateY(-4px); }
  .companion-card.selected .avatar-wrap {
    outline: 2px solid var(--text);
    outline-offset: 3px;
  }
  .companion-card.selected .avatar-wrap::after {
    content: "";
    position: absolute;
    bottom: -6px; right: -6px;
    width: 22px; height: 22px;
    background: var(--text);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
  }
  .companion-card.selected .avatar-wrap::before {
    content: "✓";
    position: absolute;
    bottom: -4px; right: -3px;
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    z-index: 2;
  }
  .avatar-wrap {
    position: relative;
    width: 140px; height: 140px;
    border-radius: 50%;
    overflow: hidden;
    margin-bottom: 14px;
    background: var(--bg-elev);
    transition: outline .2s ease;
    border: 1px solid var(--border);
  }
  .companion-name {
    font-size: 15px;
    font-weight: 500;
    margin-bottom: 2px;
  }
  .companion-name em { font-style: italic; font-weight: 400; color: var(--text-muted); font-size: 13px; }
  .companion-role {
    font-size: 12px;
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }

  /* ===== Artist Avatars (flat SVG illustrations) ===== */
  .avatar-wrap svg { width: 100%; height: 100%; display: block; }

  /* ===== Sticky Footer ===== */
  .footer-bar {
    position: fixed; left: 0; right: 0; bottom: 0;
    padding: 20px 40px;
    background: rgba(250,250,250,0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: 1px solid var(--border);
    display: flex; align-items: center; justify-content: space-between;
    z-index: 10;
  }
  .selected-count {
    font-size: 13px;
    color: var(--text-muted);
  }
  .selected-count b { color: var(--text); font-weight: 500; }
  .btn-primary {
    padding: 14px 32px;
    background: var(--text);
    color: #fff;
    border-radius: var(--radius-full);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.02em;
    transition: opacity .2s;
  }
  .btn-primary:disabled { opacity: 0.3; cursor: not-allowed; }
  .btn-primary:not(:disabled):hover { opacity: 0.85; }

  /* ===== Page 2: Shopping Page ===== */
  .shop-page { padding: 0 24px 160px; }
  .shop-header {
    padding: 20px 0;
    display: flex; align-items: center; gap: 12px;
  }
  .back-btn {
    font-size: 13px;
    color: var(--text-muted);
    letter-spacing: 0.03em;
  }
  .back-btn:hover { color: var(--text); }
  .progress {
    flex: 1;
    height: 2px;
    background: var(--border);
    border-radius: 2px;
    overflow: hidden;
  }
  .progress-bar {
    height: 100%;
    background: var(--text);
    width: 0%;
    transition: width .5s ease;
  }
  .progress-num {
    font-size: 12px;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  /* Product Card */
  .product {
    margin-top: 16px;
    animation: fadeIn .5s ease;
  }
  .product-img {
    width: 100%;
    aspect-ratio: 3 / 4;
    background: var(--bg-elev);
    border-radius: var(--radius);
    overflow: hidden;
    position: relative;
    border: 1px solid var(--border);
    display: flex; align-items: center; justify-content: center;
  }
  .product-img svg { width: 70%; height: 90%; }

  .product-meta {
    margin-top: 20px;
  }
  .product-brand {
    font-size: 12px;
    color: var(--text-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .product-name {
    font-size: 20px;
    font-weight: 500;
    margin-bottom: 4px;
  }
  .product-desc {
    font-size: 13px;
    color: var(--text-muted);
    margin-bottom: 16px;
  }
  .product-price {
    font-size: 18px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .product-actions {
    display: flex; gap: 12px; margin-top: 20px;
  }
  .btn-ghost {
    flex: 1;
    padding: 14px 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    font-size: 13px;
    color: var(--text);
    transition: all .2s;
  }
  .btn-ghost:hover { border-color: var(--text); }
  .btn-ghost.active { background: var(--text); color: #fff; border-color: var(--text); }

  /* ===== Companion Chat Layer ===== */
  .chat-layer {
    position: fixed;
    bottom: 0; left: 0; right: 0;
    padding: 16px 24px 20px;
    pointer-events: none;
    z-index: 5;
  }
  .bubble {
    pointer-events: auto;
    position: relative;
    max-width: 260px;
    padding: 12px 16px;
    background: #1A1A1A;
    color: #fff;
    font-size: 13px;
    line-height: 1.55;
    border-radius: 12px;
    margin-bottom: 8px;
    animation: bubbleIn .35s cubic-bezier(.2,.8,.2,1.2);
  }
  .bubble .who {
    font-size: 11px;
    color: rgba(255,255,255,0.55);
    letter-spacing: 0.06em;
    margin-bottom: 4px;
    text-transform: uppercase;
  }
  .bubble::before {
    content: "";
    position: absolute;
    bottom: -6px;
    left: 28px;
    width: 12px; height: 12px;
    background: #1A1A1A;
    transform: rotate(45deg);
    border-radius: 0 0 2px 0;
  }
  @keyframes bubbleIn {
    from { opacity: 0; transform: translateY(12px) scale(.9); }
    to { opacity: 1; transform: none; }
  }

  /* Companion Avatar Bar */
  .companion-bar {
    display: flex;
    gap: 10px;
    padding-top: 8px;
  }
  .mini-avatar {
    width: 44px; height: 44px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    border: 1.5px solid var(--border);
    background: var(--bg-elev);
    cursor: pointer;
    transition: transform .2s, border-color .2s;
    pointer-events: auto;
  }
  .mini-avatar:hover { transform: scale(1.08); }
  .mini-avatar.speaking {
    border-color: var(--text);
    animation: pulse 1.2s ease infinite;
  }
  @keyframes pulse {
    0%,100% { box-shadow: 0 0 0 0 rgba(26,26,26,0.15); }
    50% { box-shadow: 0 0 0 6px rgba(26,26,26,0); }
  }
  .mini-avatar svg { width: 100%; height: 100%; }

  /* Reply prompt */
  .reply-hint {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 6px 12px;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 10px;
    pointer-events: auto;
    cursor: pointer;
    transition: all .2s;
  }
  .reply-hint:hover { color: var(--text); border-color: var(--text); }

  /* ===== Nav Arrows ===== */
  .product-nav {
    display: flex;
    justify-content: center;
    gap: 48px;
    margin-top: 28px;
  }
