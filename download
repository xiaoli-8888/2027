<script>
(function initIntro() {
  var canvas = document.getElementById('introCanvas');
  if (!canvas) return;

  // ===== Three.js 场景 =====
  var scene = new THREE.Scene();
  var camera = new THREE.PerspectiveCamera(55, window.innerWidth / window.innerHeight, 0.1, 100);
  camera.position.set(0, 0, 8);
  camera.lookAt(0, -0.5, -3);

  var renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, alpha: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setClearColor(0x000000, 0);
  renderer.shadowMap.enabled = true;
  renderer.shadowMap.type = THREE.PCFSoftShadowMap;

  // 光照：环境光 + 方向光（投射阴影）
  // 环境光调高确保卡片和飞机保持纯白
  scene.add(new THREE.AmbientLight(0xffffff, 1.3));
  var keyLight = new THREE.DirectionalLight(0xffffff, 0.9);
  keyLight.position.set(2, 6, 5);
  keyLight.castShadow = true;
  keyLight.shadow.mapSize.set(2048, 2048);
  keyLight.shadow.camera.near = 0.5;
  keyLight.shadow.camera.far = 25;
  keyLight.shadow.camera.left = -6;
  keyLight.shadow.camera.right = 6;
  keyLight.shadow.camera.top = 6;
  keyLight.shadow.camera.bottom = -6;
  keyLight.shadow.bias = -0.0005;
  scene.add(keyLight);
  var fillLight = new THREE.DirectionalLight(0xfff5e8, 0.25);
  fillLight.position.set(-3, 2, 3);
  scene.add(fillLight);

  // 阴影接收地面（不可见，只显示阴影）
  var shadowGround = new THREE.Mesh(
    new THREE.PlaneGeometry(40, 40),
    new THREE.ShadowMaterial({ opacity: 0.25 })
  );
  shadowGround.rotation.x = -Math.PI / 2;
  shadowGround.position.y = -1.6;
  shadowGround.receiveShadow = true;
  scene.add(shadowGround);

  // ===== 3D 城市背景：Poly Haven 完整城市场景 =====
  var mapGroup = new THREE.Group();
  scene.add(mapGroup);

  var groundY = -1.6;

  // 加载完整城市场景（含道路、河流、建筑、树木、路灯、汽车等）
  loadGLB('city_full.glb', function (model) {
    var box = new THREE.Box3().setFromObject(model);
    var size = box.getSize(new THREE.Vector3());
    var center = box.getCenter(new THREE.Vector3());
    var targetW = 30;
    var scale = targetW / size.x;
    model.scale.setScalar(scale);
    model.position.set(
      -center.x * scale,
      groundY - (box.min.y * scale),
      -center.z * scale - 4
    );
    model.traverse(function (child) {
      if (child.isMesh) {
        child.castShadow = true;
        child.receiveShadow = true;
      }
    });
    mapGroup.add(model);
  });

  // 动态汽车（叠加在静态场景上）
  var cars = [];
  var carColors = [0xDC236E, 0xFFFFFF, 0x2196F3, 0xFF9800, 0x4CAF50, 0xFFEB3B, 0x9C27B0, 0x00BCD4];
  function makeCar(color) {
    var car = new THREE.Group();
    var body = new THREE.Mesh(
      new THREE.BoxGeometry(0.42, 0.16, 0.85),
      new THREE.MeshStandardMaterial({ color: color, roughness: 0.35, metalness: 0.4 })
    );
    body.position.y = 0.14; body.castShadow = true; car.add(body);
    var cabin = new THREE.Mesh(
      new THREE.BoxGeometry(0.34, 0.12, 0.4),
      new THREE.MeshStandardMaterial({ color: 0x222222, roughness: 0.1, metalness: 0.6 })
    );
    cabin.position.set(0, 0.26, -0.05); car.add(cabin);
    var wheelGeo = new THREE.CylinderGeometry(0.07, 0.07, 0.08, 10);
    var wheelMat = new THREE.MeshStandardMaterial({ color: 0x1a1a1a, roughness: 0.8 });
    [[-0.18, 0.07, 0.28], [0.18, 0.07, 0.28], [-0.18, 0.07, -0.28], [0.18, 0.07, -0.28]].forEach(function (wp) {
      var w = new THREE.Mesh(wheelGeo, wheelMat);
      w.rotation.z = Math.PI / 2;
      w.position.set(wp[0], wp[1], wp[2]);
      car.add(w);
    });
    return car;
  }
  var carPlacements = [
    { x: -8, z: 1, dir: 'x', speed: 0.5 },
    { x: -3, z: -2, dir: 'x', speed: -0.4 },
    { x: 4, z: 2, dir: 'x', speed: 0.6 },
    { x: 9, z: -1, dir: 'x', speed: -0.45 },
    { x: -5, z: -5, dir: 'z', speed: 0.4 },
    { x: 2, z: -7, dir: 'z', speed: -0.5 },
    { x: 7, z: -4, dir: 'z', speed: 0.35 },
    { x: -1, z: -10, dir: 'z', speed: -0.4 }
  ];
  carPlacements.forEach(function (cp, i) {
    var car = makeCar(carColors[i % carColors.length]);
    car.position.set(cp.x, groundY + 0.01, cp.z);
    if (cp.dir === 'x') {
      car.rotation.y = cp.speed > 0 ? -Math.PI / 2 : Math.PI / 2;
    } else {
      car.rotation.y = cp.speed > 0 ? 0 : Math.PI;
    }
    car.userData = { roadX: cp.x, roadZ: cp.z, dir: cp.dir, speed: cp.speed, range: 12 };
    mapGroup.add(car);
    cars.push(car);
  });

  window._cityCars = cars;
  window._updateCityTraffic = function (t) {
    cars.forEach(function (car) {
      var ud = car.userData;
      if (ud.dir === 'x') {
        car.position.x = ud.roadX + Math.sin(t * ud.speed) * ud.range;
      } else {
        car.position.z = ud.roadZ + Math.sin(t * ud.speed) * ud.range;
      }
    });
  };  };

  // ===== 卡片纹理：纯白圆角纸卡（无边框、无箭头、无文字） =====
  var cardTex;
  function makeCardTexture() {
    var c = document.createElement('canvas');
    c.width = 1024; c.height = 1365;
    var ctx = c.getContext('2d');
    // 白底圆角
    ctx.fillStyle = '#ffffff';
    roundRect(ctx, 10, 10, 1004, 1345, 60);
    ctx.fill();
    var tex = new THREE.CanvasTexture(c);
    tex.colorSpace = THREE.SRGBColorSpace;
    return tex;
  }
  function roundRect(ctx, x, y, w, h, r) {
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.lineTo(x + w - r, y);
    ctx.quadraticCurveTo(x + w, y, x + w, y + r);
    ctx.lineTo(x + w, y + h - r);
    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
    ctx.lineTo(x + r, y + h);
    ctx.quadraticCurveTo(x, y + h, x, y + h - r);
    ctx.lineTo(x, y + r);
    ctx.quadraticCurveTo(x, y, x + r, y);
    ctx.closePath();
  }

  cardTex = makeCardTexture();

  // ===== 白色纸张材质（MeshBasicMaterial 确保纯白，不受光照影响） =====
  function makePaperMat(uOffset) {
    var t = cardTex.clone();
    t.wrapS = THREE.ClampToEdgeWrapping;
    t.wrapT = THREE.ClampToEdgeWrapping;
    t.offset.set(uOffset, 0);
    t.repeat.set(0.5, 1);
    return new THREE.MeshBasicMaterial({
      map: t,
      side: THREE.DoubleSide,
      transparent: true
    });
  }

  // 左半显示纹理左半边(u 0~0.5)，右半显示右半边(u 0.5~1)
  var cardMatL = makePaperMat(0);
  var cardMatR = makePaperMat(0.5);

  // ===== 卡片：左右两半（用于对折动画） =====
  var cardW = 2.4, cardH = 3.2;
  var halfW = cardW / 2;

  var cardRoot = new THREE.Group();
  scene.add(cardRoot);

  var leftGroup = new THREE.Group();
  cardRoot.add(leftGroup);
  var cardL = new THREE.Mesh(new THREE.PlaneGeometry(halfW, cardH), cardMatL);
  cardL.position.x = -halfW / 2;
  leftGroup.add(cardL);

  var rightGroup = new THREE.Group();
  cardRoot.add(rightGroup);
  var cardR = new THREE.Mesh(new THREE.PlaneGeometry(halfW, cardH), cardMatR);
  cardR.position.x = halfW / 2;
  rightGroup.add(cardR);

  // ===== 卡片投影（跟随卡片的软阴影） =====
  function makeShadowTexture() {
    var c = document.createElement('canvas');
    c.width = 256; c.height = 256;
    var ctx = c.getContext('2d');
    var g = ctx.createRadialGradient(128, 128, 20, 128, 128, 128);
    g.addColorStop(0, 'rgba(0,0,0,0.35)');
    g.addColorStop(0.6, 'rgba(0,0,0,0.12)');
    g.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.fillStyle = g;
    ctx.fillRect(0, 0, 256, 256);
    var tex = new THREE.CanvasTexture(c);
    return tex;
  }
  var cardShadow = new THREE.Mesh(
    new THREE.PlaneGeometry(cardW * 1.1, cardH * 0.4),
    new THREE.MeshBasicMaterial({
      map: makeShadowTexture(),
      transparent: true,
      depthWrite: false
    })
  );
  cardShadow.rotation.x = -Math.PI / 2;
  cardShadow.position.y = -1.58;
  cardRoot.add(cardShadow);

  // ===== 纸飞机：经典 dart 造型 =====
  // 用 ShapeGeometry 创建飞机轮廓，分左右两半沿中线折叠
  var planeW = 2.6, planeH = 3.4;
  var noseY = planeH / 2;
  var wingTipY = -planeH / 2 + 0.3;
  var wingTipX = planeW / 2;
  var tailNotchY = -planeH / 2;
  var tailX = 0.12;

  // 左半飞机形状
  var leftShape = new THREE.Shape();
  leftShape.moveTo(0, noseY);
  leftShape.lineTo(-wingTipX, wingTipY);
  leftShape.lineTo(-tailX, tailNotchY + 0.4);
  leftShape.lineTo(0, tailNotchY);
  leftShape.lineTo(0, noseY);

  // 右半飞机形状
  var rightShape = new THREE.Shape();
  rightShape.moveTo(0, noseY);
  rightShape.lineTo(wingTipX, wingTipY);
  rightShape.lineTo(tailX, tailNotchY + 0.4);
  rightShape.lineTo(0, tailNotchY);
  rightShape.lineTo(0, noseY);

  // 白色纸张材质（飞机用纯白，不受光照影响）
  function makeWhiteMat() {
    return new THREE.MeshBasicMaterial({
      color: 0xffffff,
      side: THREE.DoubleSide,
      transparent: true
    });
  }
  var planeMatL = makeWhiteMat();
  var planeMatR = makeWhiteMat();

  var planeRoot = new THREE.Group();
  planeRoot.visible = false;
  scene.add(planeRoot);

  var planeLeftGroup = new THREE.Group();
  planeRoot.add(planeLeftGroup);
  var planeLeft = new THREE.Mesh(new THREE.ShapeGeometry(leftShape), planeMatL);
  planeLeft.castShadow = true;
  planeLeftGroup.add(planeLeft);

  var planeRightGroup = new THREE.Group();
  planeRoot.add(planeRightGroup);
  var planeRight = new THREE.Mesh(new THREE.ShapeGeometry(rightShape), planeMatR);
  planeRight.castShadow = true;
  planeRightGroup.add(planeRight);

  // 中线折痕（细深色线，模拟真实折纸折痕）
  var foldLineGeo = new THREE.PlaneGeometry(0.02, planeH);
  var foldLineMat = new THREE.MeshBasicMaterial({
    color: 0xc8c0b8,
    transparent: true,
    opacity: 0.6
  });
  var foldLine = new THREE.Mesh(foldLineGeo, foldLineMat);
  foldLine.position.z = 0.001;
  planeRoot.add(foldLine);

  // ===== 状态机 =====
  var STATE = { SLIDE_IN: 0, IDLE: 1, FOLDING: 2, FLYING: 3, DONE: 4 };
  var state = STATE.SLIDE_IN;
  var foldProgress = 0;
  var flyProgress = 0;
  var slideProgress = 0;
  var textShown = false;

  // ===== 文字逐个出现动画 =====
  function showCardText() {
    if (textShown) return;
    textShown = true;
    var helloEl = document.getElementById('helloText');
    var cnEl = document.getElementById('cnText');
    if (!helloEl || !cnEl) return;
    var helloStr = 'hello';
    var cnStr = '欢迎来到友好购物空间';
    // 清空
    helloEl.innerHTML = '';
    cnEl.innerHTML = '';
    var delay = 0;
    // hello 每个字母
    for (var i = 0; i < helloStr.length; i++) {
      var sp = document.createElement('span');
      sp.className = 'char';
      sp.textContent = helloStr[i];
      sp.style.animationDelay = delay + 's';
      helloEl.appendChild(sp);
      delay += 0.06;
    }
    delay += 0.2;
    // 中文每个字（分两行：欢迎来到 / 友好购物空间）
    for (var j = 0; j < cnStr.length; j++) {
      var sp2 = document.createElement('span');
      sp2.className = 'char';
      sp2.textContent = cnStr[j];
      sp2.style.animationDelay = delay + 's';
      cnEl.appendChild(sp2);
      delay += 0.08;
      if (j === 3) {
        cnEl.appendChild(document.createElement('br'));
      }
    }
    syncTextToCard();
  }

  function hideCardText() {
    var el = document.getElementById('introCardText');
    if (el) el.classList.add('fade-out');
  }

  var isDragging = false, dragStartY = 0, dragDist = 0;
  var hintEl = document.getElementById('introHint');

  function easeInOutCubic(t) {
    return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
  }
  function easeOutCubic(t) { return 1 - Math.pow(1 - t, 3); }

  // 贝塞尔飞行路径：直接向上飞出屏幕
  var flyPath = [
    new THREE.Vector3(0, 0, 0),           // 起点
    new THREE.Vector3(0, 3, 0),           // 向上
    new THREE.Vector3(0, 6.5, 0),         // 继续向上
    new THREE.Vector3(0, 11, 0)           // 飞出屏幕顶部
  ];
  function bezierPoint(p0, p1, p2, p3, t) {
    var u = 1 - t;
    return p0.clone().multiplyScalar(u * u * u)
      .add(p1.clone().multiplyScalar(3 * u * u * t))
      .add(p2.clone().multiplyScalar(3 * u * t * t))
      .add(p3.clone().multiplyScalar(t * t * t));
  }
  function bezierTangent(p0, p1, p2, p3, t) {
    var u = 1 - t;
    return p1.clone().sub(p0).multiplyScalar(3 * u * u)
      .add(p2.clone().sub(p1).multiplyScalar(6 * u * t))
      .add(p3.clone().sub(p2).multiplyScalar(3 * t * t));
  }

  // 拖拽
  window.addEventListener('mousedown', function (e) {
    if (state !== STATE.IDLE) return;
    isDragging = true;
    dragStartY = e.clientY;
    dragDist = 0;
  });
  window.addEventListener('mousemove', function (e) {
    if (!isDragging) return;
    var dy = e.clientY - dragStartY;
    if (dy > 0) {
      dragDist = Math.max(dragDist, dy);
      foldProgress = Math.min(dragDist / 160, 1);
      if (foldProgress > 0 && state === STATE.IDLE) {
        state = STATE.FOLDING;
        hideCardText();
      }
    }
    if (hintEl) {
      if (foldProgress < 0.3) hintEl.textContent = '继续拖动... 卡片正在对折';
      else if (foldProgress < 0.7) hintEl.textContent = '快折好了！纸飞机即将成型';
      else hintEl.textContent = '最后一下！';
    }
  });
  window.addEventListener('mouseup', function () {
    if (!isDragging) return;
    isDragging = false;
    if (foldProgress >= 1) {
      startFlying();
    } else if (foldProgress > 0) {
      var sb = setInterval(function () {
        foldProgress -= 0.04;
        if (foldProgress <= 0) {
          foldProgress = 0; clearInterval(sb); state = STATE.IDLE;
          if (hintEl) hintEl.textContent = '按住卡片向下拖动';
        }
      }, 16);
    }
  });

  function startFlying() {
    state = STATE.FLYING;
    flyProgress = 0;
    if (hintEl) hintEl.classList.add('hide');
  }

  // ===== 折叠/变形更新 =====
  function updateFold(fp) {
    var a = easeInOutCubic(fp);

    // 卡片对折
    var foldAngle = a * (Math.PI / 2.05);
    leftGroup.rotation.y = -foldAngle;
    rightGroup.rotation.y = foldAngle;

    // 卡片缩小 + 淡出
    var cardScale = 1 - a * 0.4;
    cardRoot.scale.set(cardScale, cardScale, cardScale);
    var cardOpacity = 1 - a;
    cardMatL.opacity = cardOpacity;
    cardMatR.opacity = cardOpacity;
    cardShadow.material.opacity = cardOpacity;

    // 纸飞机淡入 + 放大
    planeRoot.visible = a > 0.05;
    planeRoot.scale.setScalar(a);
    planeMatL.opacity = a;
    planeMatR.opacity = a;
    foldLineMat.opacity = a * 0.6;

    // 飞机左右机翼沿中线向上折叠（形成立体机身）
    var wingFold = a * 0.35;
    planeLeftGroup.rotation.y = -wingFold;
    planeRightGroup.rotation.y = wingFold;
  }

  // 字体由 Google Fonts 加载，HTML 文字层直接使用 CSS 字体

  // 让 HTML 文字实时跟随 3D 卡片位置
  var _projVec = new THREE.Vector3();
  function syncTextToCard() {
    var textEl = document.getElementById('introCardText');
    if (!textEl) return;
    _projVec.copy(cardRoot.position).project(camera);
    var sx = (_projVec.x * 0.5 + 0.5) * window.innerWidth;
    var sy = (-_projVec.y * 0.5 + 0.5) * window.innerHeight;
    textEl.style.left = sx + 'px';
    textEl.style.top = sy + 'px';
  }

  // ===== 动画循环 =====
  var clock = new THREE.Clock();
  // ===== 城市手动拖拽旋转 =====
  var cityRotY = 0;      // 水平旋转角度
  var cityRotX = -0.1;   // 初始倾斜（接近平视）
  var isDragging = false;
  var lastX = 0, lastY = 0;
  var rotVelocityY = 0, rotVelocityX = 0;

  function onPointerDown(e) {
    isDragging = true;
    var p = e.touches ? e.touches[0] : e;
    lastX = p.clientX;
    lastY = p.clientY;
    rotVelocityY = 0;
    rotVelocityX = 0;
  }
  function onPointerMove(e) {
    if (!isDragging) return;
    var p = e.touches ? e.touches[0] : e;
    var dx = p.clientX - lastX;
    var dy = p.clientY - lastY;
    lastX = p.clientX;
    lastY = p.clientY;
    rotVelocityY = dx * 0.005;
    rotVelocityX = dy * 0.005;
    cityRotY += rotVelocityY;
    cityRotX += rotVelocityX;
    // 限制垂直旋转角度
    cityRotX = Math.max(-1.2, Math.min(0.3, cityRotX));
  }
  function onPointerUp() {
    isDragging = false;
  }

  canvas.addEventListener('mousedown', onPointerDown);
  window.addEventListener('mousemove', onPointerMove);
  window.addEventListener('mouseup', onPointerUp);
  canvas.addEventListener('touchstart', onPointerDown, { passive: true });
  window.addEventListener('touchmove', onPointerMove, { passive: true });
  window.addEventListener('touchend', onPointerUp);

  function animate() {
    requestAnimationFrame(animate);
    var dt = clock.getDelta();
    var t = clock.getElapsedTime();

    // 拖拽旋转 + 松手后惯性衰减 + 缓慢自动浮动
    if (!isDragging) {
      cityRotY += rotVelocityY;
      cityRotX += rotVelocityX;
      rotVelocityY *= 0.95;
      rotVelocityX *= 0.95;
      cityRotX = Math.max(-1.2, Math.min(0.3, cityRotX));
    }
    mapGroup.rotation.y = cityRotY;
    mapGroup.rotation.x = cityRotX;
    // 车辆移动
    if (window._updateCityTraffic) window._updateCityTraffic(t);

    if (state === STATE.SLIDE_IN) {
      slideProgress = Math.min(slideProgress + dt * 0.8, 1);
      var e = easeOutCubic(slideProgress);
      cardRoot.position.y = -5 + e * 5;
      planeRoot.position.y = cardRoot.position.y;
      if (slideProgress >= 1) {
        state = STATE.IDLE;
        showCardText();
      }
    }

    if (state === STATE.IDLE) {
      cardRoot.position.y = Math.sin(t * 1.5) * 0.06;
      cardRoot.rotation.z = Math.sin(t * 1.2) * 0.01;
      planeRoot.position.y = cardRoot.position.y;
      syncTextToCard();
    }

    if (state === STATE.IDLE || state === STATE.FOLDING) {
      if (foldProgress > 0 && state === STATE.IDLE) state = STATE.FOLDING;
      updateFold(foldProgress);
      if (state === STATE.FOLDING) syncTextToCard();
    }

    if (state === STATE.FLYING) {
      updateFold(1);
      flyProgress = Math.min(flyProgress + dt * 0.35, 1);
      var ft = easeInOutCubic(flyProgress);
      var pos = bezierPoint(flyPath[0], flyPath[1], flyPath[2], flyPath[3], ft);
      cardRoot.position.copy(pos);
      planeRoot.position.copy(pos);
      var tan = bezierTangent(flyPath[0], flyPath[1], flyPath[2], flyPath[3], ft);
      // 飞机直接朝上飞，保持折叠后的姿态（机头朝上），不做 lookAt 避免掉头
      planeRoot.rotation.set(0, 0, Math.sin(t * 3) * 0.04);
      if (flyProgress >= 1) {
        state = STATE.DONE;
        setTimeout(function () {
          var intro = document.getElementById('page-intro');
          if (intro) intro.style.display = 'none';
          document.getElementById('page-select').classList.add('active');
        }, 300);
      }
    }

    renderer.render(scene, camera);
  }
  animate();

  window.addEventListener('resize', function () {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  });
})();
</script>
</body></html>
