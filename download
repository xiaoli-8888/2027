<html lang="zh-CN" class="light"><head>
<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js"></script>
<script>
// 精简 GLB 加载器（内联，支持贴图纹理）
function loadGLB(url, onLoad, onError) {
  // 计算贴图相对路径的基准目录
  var basePath = url.substring(0, url.lastIndexOf('/') + 1);
  fetch(url).then(function(r){ return r.arrayBuffer(); }).then(function(buf){
    var dv = new DataView(buf);
    var magic = dv.getUint32(0, true);
    if (magic !== 0x46546C67) { onError && onError('not glb'); return; }
    var version = dv.getUint32(4, true);
    var totalLen = dv.getUint32(8, true);
    var offset = 12;
    var json = null, binData = null;
    while (offset < totalLen) {
      var chunkLen = dv.getUint32(offset, true);
      var chunkType = dv.getUint32(offset + 4, true);
      var chunkData = buf.slice(offset + 8, offset + 8 + chunkLen);
      if (chunkType === 0x4E4F534A) {
        json = JSON.parse(new TextDecoder().decode(chunkData));
      } else if (chunkType === 0x004E4942) {
        binData = chunkData;
      }
      offset += 8 + chunkLen;
    }
    if (!json) { onError && onError('no json'); return; }

    var buffers = [binData || new ArrayBuffer(0)];
    var accessorCache = {};
    function getAccessor(idx) {
      if (accessorCache[idx] !== undefined) return accessorCache[idx];
      var acc = json.accessors[idx];
      var bv = json.bufferViews[acc.bufferView];
      var buffer = buffers[bv.buffer || 0];
      var byteOffset = (bv.byteOffset || 0) + (acc.byteOffset || 0);
      var count = acc.count;
      var type = acc.type;
      var compSize = { SCALAR:1, VEC2:2, VEC3:3, VEC4:4, MAT4:16 }[type];
      var arr;
      if (acc.componentType === 5126) {
        arr = new Float32Array(buffer, byteOffset, count * compSize);
      } else if (acc.componentType === 5123) {
        arr = new Uint16Array(buffer, byteOffset, count * compSize);
      } else if (acc.componentType === 5125) {
        arr = new Uint32Array(buffer, byteOffset, count * compSize);
      } else if (acc.componentType === 5121) {
        arr = new Uint8Array(buffer, byteOffset, count * compSize);
      } else {
        arr = new Float32Array(buffer, byteOffset, count * compSize);
      }
      accessorCache[idx] = { array: arr, count: count, compSize: compSize, componentType: acc.componentType };
      return accessorCache[idx];
    }

    // 加载 embedded 图片为 THREE.Texture
    var textures = [];
    if (json.images) {
      json.images.forEach(function(imgDef){
        var tex = null;
        if (imgDef.bufferView !== undefined) {
          var bv = json.bufferViews[imgDef.bufferView];
          var buffer = buffers[bv.buffer || 0];
          var imgBuf = buffer.slice(bv.byteOffset || 0, (bv.byteOffset || 0) + bv.byteLength);
          var mime = imgDef.mimeType || 'image/png';
          var blob = new Blob([imgBuf], { type: mime });
          var url = URL.createObjectURL(blob);
          tex = new THREE.TextureLoader().load(url);
          tex.colorSpace = THREE.SRGBColorSpace;
          tex.wrapS = THREE.RepeatWrapping;
          tex.wrapT = THREE.RepeatWrapping;
        } else if (imgDef.uri) {
          // 外部 URI：相对于 GLB 文件所在目录解析
          tex = new THREE.TextureLoader().load(basePath + imgDef.uri);
          tex.colorSpace = THREE.SRGBColorSpace;
        }
        textures.push(tex);
      });
    }

    function buildMesh(meshIdx) {
      var meshDef = json.meshes[meshIdx];
      var group = new THREE.Group();
      meshDef.primitives.forEach(function(prim){
        var geo = new THREE.BufferGeometry();
        if (prim.attributes.POSITION !== undefined) {
          var pos = getAccessor(prim.attributes.POSITION);
          geo.setAttribute('position', new THREE.BufferAttribute(new Float32Array(pos.array), pos.compSize));
        }
        if (prim.attributes.NORMAL !== undefined) {
          var nrm = getAccessor(prim.attributes.NORMAL);
          geo.setAttribute('normal', new THREE.BufferAttribute(new Float32Array(nrm.array), nrm.compSize));
        }
        // UV 坐标
        if (prim.attributes.TEXCOORD_0 !== undefined) {
          var uv = getAccessor(prim.attributes.TEXCOORD_0);
          geo.setAttribute('uv', new THREE.BufferAttribute(new Float32Array(uv.array), uv.compSize));
        }
        // 顶点颜色（Poly.Pizza 模型常用）
        var hasVertexColors = false;
        if (prim.attributes.COLOR_0 !== undefined) {
          var col = getAccessor(prim.attributes.COLOR_0);
          var colArr;
          if (col.componentType === 5121) {
            // UNSIGNED_BYTE，需要归一化
            colArr = new Float32Array(col.array.length);
            for (var ci = 0; ci < col.array.length; ci++) colArr[ci] = col.array[ci] / 255;
          } else {
            colArr = new Float32Array(col.array);
          }
          geo.setAttribute('color', new THREE.BufferAttribute(colArr, col.compSize));
          hasVertexColors = true;
        }
        if (prim.indices !== undefined) {
          var idx = getAccessor(prim.indices);
          geo.setIndex(new THREE.BufferAttribute(idx.array, 1));
        }
        // 材质（支持贴图 + 顶点色）
        var mat;
        if (prim.material !== undefined && json.materials) {
          var mDef = json.materials[prim.material];
          var color = 0xffffff;
          var mapTex = null;
          if (mDef.pbrMetallicRoughness) {
            if (mDef.pbrMetallicRoughness.baseColorFactor) {
              var c = mDef.pbrMetallicRoughness.baseColorFactor;
              color = new THREE.Color(c[0], c[1], c[2]).getHex();
            }
            if (mDef.pbrMetallicRoughness.baseColorTexture !== undefined && json.textures) {
              var texIdx = json.textures[mDef.pbrMetallicRoughness.baseColorTexture.index].source;
              mapTex = textures[texIdx];
            }
          }
          mat = new THREE.MeshStandardMaterial({
            color: color,
            map: mapTex,
            vertexColors: hasVertexColors,
            roughness: 0.85,
            metalness: 0.0
          });
        } else {
          mat = new THREE.MeshStandardMaterial({ color: 0xcccccc, vertexColors: hasVertexColors, roughness: 0.85 });
        }
        var mesh = new THREE.Mesh(geo, mat);
        mesh.castShadow = true;
        mesh.receiveShadow = true;
        group.add(mesh);
      });
      return group;
    }

    var root = new THREE.Group();
    var sceneIdx = json.scene || 0;
    var sceneDef = json.scenes[sceneIdx];
    function addNode(nodeIdx, parent) {
      var nDef = json.nodes[nodeIdx];
      var obj;
      if (nDef.mesh !== undefined) {
        obj = buildMesh(nDef.mesh);
      } else {
        obj = new THREE.Group();
      }
      if (nDef.translation) obj.position.fromArray(nDef.translation);
      if (nDef.rotation) obj.quaternion.fromArray(nDef.rotation);
      if (nDef.scale) obj.scale.fromArray(nDef.scale);
      if (nDef.matrix) obj.matrix.fromArray(nDef.matrix).decompose(obj.position, obj.quaternion, obj.scale);
      parent.add(obj);
      if (nDef.children) nDef.children.forEach(function(c){ addNode(c, obj); });
    }
    sceneDef.nodes.forEach(function(n){ addNode(n, root); });
    onLoad(root);
  }).catch(onError || function(e){ console.error('GLB load error', e); });
}
</script>
