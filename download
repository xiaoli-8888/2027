  .btn-primary {
    padding: 14px 32px;
    background: var(--text);
    color: #fff;
    border-radius: var(--radius-full);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.02em;
    transition: opacity .2s;
  }
  .btn-primary:disabled { opacity: 0.3; cursor: not-allowed; }
  .btn-primary:not(:disabled):hover { opacity: 0.85; }

  /* ===== Page 2: Shopping Page ===== */
  .shop-page { padding: 0 24px 160px; }
  .shop-header {
    padding: 20px 0;
    display: flex; align-items: center; gap: 12px;
  }
  .back-btn {
    font-size: 13px;
    color: var(--text-muted);
    letter-spacing: 0.03em;
  }
  .back-btn:hover { color: var(--text); }
  .progress {
    flex: 1;
    height: 2px;
    background: var(--border);
    border-radius: 2px;
    overflow: hidden;
  }
  .progress-bar {
    height: 100%;
    background: var(--text);
    width: 0%;
    transition: width .5s ease;
  }
  .progress-num {
    font-size: 12px;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  /* Product Card */
  .product {
    margin-top: 16px;
    animation: fadeIn .5s ease;
  }
  .product-img {
    width: 100%;
    aspect-ratio: 3 / 4;
    background: var(--bg-elev);
    border-radius: var(--radius);
    overflow: hidden;
    position: relative;
    border: 1px solid var(--border);
    display: flex; align-items: center; justify-content: center;
  }
  .product-img svg { width: 70%; height: 90%; }

  .product-meta {
    margin-top: 20px;
  }
  .product-brand {
    font-size: 12px;
    color: var(--text-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .product-name {
    font-size: 20px;
    font-weight: 500;
    margin-bottom: 4px;
  }
  .product-desc {
    font-size: 13px;
    color: var(--text-muted);
    margin-bottom: 16px;
  }
  .product-price {
    font-size: 18px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .product-actions {
    display: flex; gap: 12px; margin-top: 20px;
  }
  .btn-ghost {
    flex: 1;
    padding: 14px 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    font-size: 13px;
    color: var(--text);
    transition: all .2s;
  }
  .btn-ghost:hover { border-color: var(--text); }
  .btn-ghost.active { background: var(--text); color: #fff; border-color: var(--text); }

  /* ===== Companion Chat Layer ===== */
  .chat-layer {
    position: fixed;
    bottom: 0; left: 0; right: 0;
    padding: 16px 24px 20px;
    pointer-events: none;
    z-index: 5;
  }
  .bubble {
    pointer-events: auto;
    position: relative;
    max-width: 260px;
    padding: 12px 16px;
    background: #1A1A1A;
    color: #fff;
    font-size: 13px;
    line-height: 1.55;
    border-radius: 12px;
    margin-bottom: 8px;
    animation: bubbleIn .35s cubic-bezier(.2,.8,.2,1.2);
  }
  .bubble .who {
    font-size: 11px;
    color: rgba(255,255,255,0.55);
    letter-spacing: 0.06em;
    margin-bottom: 4px;
    text-transform: uppercase;
  }
  .bubble::before {
    content: "";
    position: absolute;
    bottom: -6px;
    left: 28px;
    width: 12px; height: 12px;
    background: #1A1A1A;
    transform: rotate(45deg);
    border-radius: 0 0 2px 0;
  }
  @keyframes bubbleIn {
    from { opacity: 0; transform: translateY(12px) scale(.9); }
    to { opacity: 1; transform: none; }
  }

  /* Companion Avatar Bar */
  .companion-bar {
    display: flex;
    gap: 10px;
    padding-top: 8px;
  }
  .mini-avatar {
    width: 44px; height: 44px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    border: 1.5px solid var(--border);
    background: var(--bg-elev);
    cursor: pointer;
    transition: transform .2s, border-color .2s;
    pointer-events: auto;
  }
  .mini-avatar:hover { transform: scale(1.08); }
  .mini-avatar.speaking {
    border-color: var(--text);
    animation: pulse 1.2s ease infinite;
  }
  @keyframes pulse {
    0%,100% { box-shadow: 0 0 0 0 rgba(26,26,26,0.15); }
    50% { box-shadow: 0 0 0 6px rgba(26,26,26,0); }
  }
  .mini-avatar svg { width: 100%; height: 100%; }

  /* Reply prompt */
  .reply-hint {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 6px 12px;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 10px;
    pointer-events: auto;
    cursor: pointer;
    transition: all .2s;
  }
  .reply-hint:hover { color: var(--text); border-color: var(--text); }

  /* ===== Nav Arrows ===== */
  .product-nav {
    display: flex;
    justify-content: center;
    gap: 48px;
    margin-top: 28px;
  }
  .nav-btn {
    padding: 10px 20px;
    border-radius: var(--radius-full);
    font-size: 13px;
    color: var(--text-muted);
    border: 1px solid var(--border);
    transition: all .2s;
  }
  .nav-btn:hover:not(:disabled) { color: var(--text); border-color: var(--text); }
  .nav-btn:disabled { opacity: 0.3; cursor: not-allowed; }

  @media (max-width: 640px) {
    .select-page { padding: 48px 24px 120px; }
    .brand-title { font-size: 36px; }
    .companions-grid { grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 24px; }
    .avatar-wrap { width: 110px; height: 110px; margin: 0 auto 10px; }
    .companion-card { text-align: center; }
    .footer-bar { padding: 16px 24px; }
  }

  /* ===== 开场 Splash 搭子入场仪式 ===== */
  /* ============ 撕开胶带开场 ============ */
  .splash {
    position: fixed; inset: 0; z-index: 9999;
    background: var(--bg);
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
    transition: opacity 0.4s ease;
  }
  .splash.torn { opacity: 0; pointer-events: none; }

  /* 标题和副标题 —— 胶带撕开后才出现 */
  .splash-title {
    position: absolute; top: 30%; left: 50%; transform: translateX(-50%);
    font-size: 52px; font-weight: 300; letter-spacing: -0.02em;
    opacity: 0; transition: opacity 0.8s ease 0.1s;
  }
  .splash.torn .splash-title { opacity: 1; }
  .splash-title em { font-style: italic; font-weight: 400; }
  .splash-sub {
    position: absolute; top: 40%; left: 50%; transform: translateX(-50%);
    font-size: 15px; color: var(--text-muted); letter-spacing: 0.05em;
    opacity: 0; transition: opacity 0.8s ease 0.3s;
  }
  .splash.torn .splash-sub { opacity: 1; }

  /* 头像 —— 胶带撕开后从下方浮现 */
  .splash-avatars {
    position: absolute; top: 55%; left: 50%;
    transform: translate(-50%, -50%);
    display: flex; gap: 24px;
    opacity: 0; transition: opacity 0.6s ease 0.5s, transform 0.8s cubic-bezier(.2,.8,.2,1) 0.5s;
  }
  .splash.torn .splash-avatars { opacity: 1; transform: translate(-50%, -50%) translateY(-10px); }
  .splash-avatar {
    width: 60px; height: 60px; border-radius: 50%;
    background: #eee; overflow: hidden;
    transform-origin: center center;
    transition: transform 0.5s cubic-bezier(.2,.8,.2,1);
  }
  .splash.torn .splash-avatar { animation: avatarPop 0.6s cubic-bezier(.2,.8,.2,1) forwards; }
  .splash.torn .splash-avatar:nth-child(1) { animation-delay: 0.55s; }
  .splash.torn .splash-avatar:nth-child(2) { animation-delay: 0.65s; }
  .splash.torn .splash-avatar:nth-child(3) { animation-delay: 0.75s; }
  .splash.torn .splash-avatar:nth-child(4) { animation-delay: 0.85s; }
  .splash.torn .splash-avatar:nth-child(5) { animation-delay: 0.95s; }
  @keyframes avatarPop {
    from { opacity: 0; transform: scale(0.5) translateY(20px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
  }
  .splash-avatar img, .splash-avatar svg { width: 100%; height: 100%; object-fit: cover; }

  /* ============ 拼贴开箱开场 ============ */
  .tape-wrap {
    position: absolute; top: 50%; left: 0; right: 0;
    transform: translateY(-50%);
    height: 320px;
    cursor: grab;
    user-select: none;
    z-index: 5;
  }
  .tape-wrap:active { cursor: grabbing; }
  .collage-svg {
    width: 100%; height: 100%;
    display: block;
  }
  /* 胶带飞出动画 */
  .collage-svg .tape-piece {
    transform-origin: center center;
  }
  .tape-wrap.tearing .collage-svg .tape-piece {
    animation: tapeFly 0.65s cubic-bezier(.2,.8,.2,1) forwards;
  }
  .tape-wrap.tearing .collage-svg .tape-piece.tp-1 { animation-delay: 0s; }
  .tape-wrap.tearing .collage-svg .tape-piece.tp-2 { animation-delay: 0.05s; }
  .tape-wrap.tearing .collage-svg .tape-piece.tp-3 { animation-delay: 0.1s; }
  .tape-wrap.tearing .collage-svg .tape-piece.tp-4 { animation-delay: 0.15s; }

  @keyframes tapeFly {
    0%   { transform: translate(0,0) rotate(0deg) scale(1); opacity: 1; }
    30%  { transform: translate(var(--fx,0), var(--fy,8px)) rotate(var(--fr,-12deg)) scale(0.85); opacity: 1; }
    100% { transform: translate(calc(var(--fx,0)*2.5), calc(var(--fy,8px)*4)) rotate(calc(var(--fr,-12deg)*2)) scale(0.5); opacity: 0; }
  }
  /* 底下的拼贴内容延迟淡出 */
  .collage-svg .under-layer {
    opacity: 0;
    transition: opacity 0.5s ease 0.3s;
  }
  .tape-wrap.tearing .collage-svg .under-layer { opacity: 1; }

  .tape-wrap.tearing {
    transition: opacity 0.15s ease 0.7s;
    opacity: 0;
  }

  /* 提示文字 */
  .tape-hint {
    position: absolute; top: -32px; left: 50%; transform: translateX(-50%);
    font-size: 11px; color: #8B7A4A; letter-spacing: 0.12em;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0.75;
    z-index: 10;
  }
  .tape-hint-arrow {
    position: absolute; bottom: -28px; left: 50%; transform: translateX(-50%);
    font-size: 16px; color: #8B7A4A;
    pointer-events: none;
    animation: hintPulse 1.6s ease-in-out infinite;
    z-index: 10;
  }
  @keyframes hintPulse {
    0%, 100% { transform: translateX(-50%) scaleX(1); opacity: 0.6; }
    50% { transform: translateX(-50%) scaleX(1.3); opacity: 1; }
  }

  /* 购物袋光标 */
  body
  .shopbag-cursor svg { width: 100%; height: 100%; }
  .shopbag-cursor.big { width: 38px; height: 44px; transform: translate(-19px, -22px); }
  
  @keyframes trailFade {
    0% { opacity: 0.8; transform: translate(-4px, -4px) scale(1); }
    100% { opacity: 0; transform: translate(-4px, -4px) scale(0.3); }
  }

  /* 主页面气泡对话 */
  .bubble {
    position: absolute; z-index: 100;
    background: #1A1A1A; color: #fff; font-size: 12px;
    padding: 8px 14px; border-radius: 14px;
    white-space: nowrap; opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -100%);
    animation: bubbleShow 3.2s forwards;
  }
  .bubble::after {
    content: ""; position: absolute; bottom: -5px; left: 50%; transform: translateX(-50%);
    border-left: 5px solid transparent; border-right: 5px solid transparent; border-top: 6px solid #1A1A1A;
  }
  @keyframes bubbleShow {
    0% { opacity: 0; transform: translate(-50%, -90%) scale(0.8); }
    15% { opacity: 1; transform: translate(-50%, -102%) scale(1.05); }
    30% { opacity: 1; transform: translate(-50%, -100%) scale(1); }
    85% { opacity: 1; }
    100% { opacity: 0; transform: translate(-50%, -104%) scale(0.95); }
  }

  /* splash 结束后显示主页面 */
  .page { opacity: 1; transition: opacity 0.6s ease; }
